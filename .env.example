# Copy to .env and set credentials for your PostgreSQL database.
# The database hostname must be reachable from both containers.
THREECOLOR_DB_URL=jdbc:postgresql://database-host:5432/threecolor
THREECOLOR_DB_USER=threecolor
THREECOLOR_DB_PASSWORD=

# Host access; use a reverse proxy for public HTTPS.
THREECOLOR_BIND_ADDRESS=127.0.0.1
THREECOLOR_PORT=18380

THREECOLOR_WEB_MEMORY=1g
THREECOLOR_WORKER_MEMORY=1g
THREECOLOR_WORKER_CPUS=0.5
# 0 keeps discovering; a positive value sets a supply target per size/difficulty.
THREECOLOR_WORKER_TARGET_PER_CELL=0
THREECOLOR_WORKER_INTERVAL_SECONDS=10
